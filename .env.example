# Copy to .env for local dev, and set the same vars in Vercel → Project → Settings → Environment Variables.

# Required: Google Gemini API key (used by api/generate.js, api/logo.js, api/mockup.js).
GEMINI_API_KEY=your-key-here

# Optional: override the image model. Defaults to gemini-3.1-flash-image (fast, ~$0.07/image).
# Use gemini-3-pro-image for higher-quality hero pre-bakes (scripts/build-heroes.mjs).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
